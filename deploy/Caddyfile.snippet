# corso-api-json — Corso JSON & API. Un solo servizio systemd (corso-api-json, 127.0.0.1:8795,
# utente corso-api, file in /opt/corso-api-json) serve /api/* (FastAPI) e il sito statico.
# Il sito è pubblico, senza basic_auth (decisione del 28/10/2026): non rimetterla.
# Niente CSP: Starlight usa script inline per tema e ricerca.
corso-api-json.giuseppebosi.com {
    encode zstd gzip {
        match {
            header Content-Type text/*
            header Content-Type application/json*
            header Content-Type application/x-ndjson*
            header Content-Type application/javascript*
            header Content-Type image/svg+xml*
        }
    }
    request_body {
        max_size 1MB
    }
    reverse_proxy 127.0.0.1:8795 {
        header_up X-Real-IP {remote_host}
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    log {
        output discard
    }
}
