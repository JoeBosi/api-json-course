---
/**
 * Piè di pagina: tiene quello di Starlight (navigazione, data di ultimo aggiornamento) e
 * aggiunge le informazioni dell'opera: autore, contatto, licenza, crediti e privacy.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import { GITHUB, GITHUB_PUBBLICO, T, lingua, pre } from '../lib/i18n';
const l = lingua(Astro.locals.starlightRoute.lang);
const f = T[l].footer;
const p = pre(l);
---

<Default><slot /></Default>

<footer class="corso-footer not-content">
  <p>
    <strong>{l === 'en' ? 'JSON & API Course' : 'Corso JSON & API'}</strong> {f.di} <a href={T[l].sitoAutore} rel="author">Giuseppe Bosi</a> (<a href="https://www.linkedin.com/in/giuseppebosi" rel="me noopener" target="_blank">LinkedIn</a>) — {f.opera}
    {f.scrivi} <a href="mailto:info@giuseppebosi.com">info@giuseppebosi.com</a>.
  </p>
  <p>
    {f.testi} <a href={`https://creativecommons.org/licenses/by/4.0/${l === 'en' ? '' : 'deed.it'}`} rel="license noopener" target="_blank">CC BY 4.0</a>,
    {f.codice} <a href={`${p}/crediti/#${l === 'en' ? 'license' : 'licenza'}`}>MIT</a> ·
    <a href={`${p}/crediti/`}>{f.crediti}</a> ·
    <a href={`${p}/privacy/`}>{f.privacy}</a>
    {GITHUB_PUBBLICO && <> · <a href={GITHUB} rel="noopener" target="_blank">{f.github}</a></>}
  </p>
  <p>
    {f.altri}
    <a href="https://corso-rag.giuseppebosi.com/">Costruisci la tua memoria AI{l === 'en' && ' (RAG course, in Italian)'}</a> ·
    <a href="https://corso-llamacpp.giuseppebosi.com/">Corso pratico di llama.cpp{l === 'en' && ' (llama.cpp course, in Italian)'}</a> ·
    <a href={T[l].sitoAutore}>www.giuseppebosi.com</a>
  </p>
</footer>

<style>
  .corso-footer {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .corso-footer p { margin: .3rem 0; }
  .corso-footer a { color: inherit; text-decoration: underline; }
</style>
