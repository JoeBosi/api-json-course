---
/**
 * Titolo nella barra in alto: il nome del corso e, sotto, il nome dell'autore con link alla
 * sua home. Sostituisce il SiteTitle di Starlight (qui non c'è un logo, quindi basta il testo).
 * La barra di Starlight è fissa in cima: la scritta resta visibile anche scorrendo la pagina.
 */
import { T, lingua } from '../lib/i18n';
const { siteTitle, siteTitleHref, lang } = Astro.locals.starlightRoute;
const l = lingua(lang);
// Bandierine SVG inline come su www.giuseppebosi.com (UK nella pagina IT, Italia nella pagina EN)
const UK = '<svg viewBox="0 0 60 30" width="22" height="11" aria-hidden="true"><clipPath id="fg"><path d="M0,0v30h60V0z"/></clipPath><clipPath id="fh"><path d="M30,15h30v15zv15H0zH0V0zV0h30z"/></clipPath><g clip-path="url(#fg)"><path d="M0,0v30h60V0z" fill="#012169"/><path d="M0,0 60,30M60,0 0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 60,30M60,0 0,30" clip-path="url(#fh)" stroke="#C8102E" stroke-width="4"/><path d="M30,0v30M0,15h60" stroke="#fff" stroke-width="10"/><path d="M30,0v30M0,15h60" stroke="#C8102E" stroke-width="6"/></g></svg>';
const IT = '<svg viewBox="0 0 3 2" width="22" height="11" preserveAspectRatio="none" aria-hidden="true"><path d="M0,0h1v2H0z" fill="#009246"/><path d="M1,0h1v2H1z" fill="#fff"/><path d="M2,0h1v2H2z" fill="#CE2B37"/></svg>';
const percorso = Astro.url.pathname;
const altra = l === 'en'
  ? { href: percorso.replace(/^\/en(\/|$)/, '/'), testo: 'IT', lang: 'it', titolo: 'Versione italiana' }
  : { href: '/en' + percorso, testo: 'EN', lang: 'en', titolo: 'English version' };
---

<div class="titolo-corso">
  <div class="riga-titolo">
    <a href={siteTitleHref} class="site-title" translate="no">{siteTitle}</a>
    <a class="lingua" href={altra.href} hreflang={altra.lang} lang={altra.lang} title={altra.titolo}>{altra.lang === 'en' ? <Fragment set:html={UK} /> : <Fragment set:html={IT} />}{altra.testo}</a>
  </div>
  <a class="autore" href={T[l].sitoAutore} rel="author">{T[l].autore}</a>
</div>

<style>
  .titolo-corso {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0;
    min-width: 0;
    line-height: 1.15;
  }
  .riga-titolo { display: flex; align-items: baseline; gap: .5rem; min-width: 0; }
  .lingua {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 600 12px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    flex-shrink: 0;
  }
  .lingua :global(svg) { border-radius: 2px; box-shadow: 0 0 0 1px #0002; }
  .lingua:hover, .lingua:focus-visible { color: var(--sl-color-text-accent); text-decoration: underline; }
  .site-title {
    font-size: var(--sl-text-h5);
    font-weight: 600;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .autore {
    font-size: var(--sl-text-xs);
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .autore:hover,
  .autore:focus-visible { color: var(--sl-color-text-accent); text-decoration: underline; }

  /* sui telefoni la barra è stretta: testo più piccolo, così entrano titolo e autore */
  @media (max-width: 30rem) {
    .site-title { font-size: var(--sl-text-sm); }
    .autore { font-size: 0.6875rem; }
  }
</style>
