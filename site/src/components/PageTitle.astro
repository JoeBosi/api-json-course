---
// Override del titolo di pagina di Starlight: aggiunge il player audio sotto il titolo dei capitoli.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import Lettura from './Lettura.astro';
const entry = Astro.locals.starlightRoute.entry;
// la lettura audio esiste solo per le pagine italiane (il manifest è costruito dal testo italiano)
const conAudio = entry.data.template !== 'splash' && Astro.locals.starlightRoute.lang !== 'en';
---
<Default><slot /></Default>
{conAudio && <Lettura slug={entry.id.replace(/\.mdx?$/, '')} />}
